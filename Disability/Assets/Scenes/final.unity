  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\rLa r\xE9tinopathie diab\xE9tique (atteinte des yeux : \u0153il et r\xE9tine)
    est une grave complication du diab\xE8te qui touche 50% des patients diab\xE9tiques
    de type 2. Les yeux sont particuli\xE8rement sensibles \xE0 l'atteinte des petits
    vaisseaux.  Elle se d\xE9veloppe en silence et peut progressivement entrainer
    une perte de la vue. Elle doit \xEAtre d\xE9pist\xE9e par les angiographies de
    la r\xE9tine et trait\xE9e par le laser.\n\nTrouve la sortie de ce labyrinthe."
  m_isRightToLeft: 0
